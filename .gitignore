# https://files.grouplens.org/datasets/movielens/ml-25m.zip
ml-25m/
ml-20m/
ml-25m.zip

# db files
*.db

# synthetic evaluation ground truth (regenerate with seed_demo_data.py)
demo_latent.json

# Python cache
__pycache__/
*.pyc
*.pyo

# Virtual env
venv/
.venv/

# Netlify local state
.netlify/

# Generated directory listing - regenerate on demand, do not track
structure.txt
