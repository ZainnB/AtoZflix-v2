# Copy to backend/.env and fill in. Never commit the real .env.
#
# On a deploy host (Railway / Render / Heroku) set these as environment
# variables in the dashboard rather than shipping a file.

# --- Flask -----------------------------------------------------------
# Signs Flask session cookies. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required. The app refuses to boot without it unless FLASK_ENV=development.
SECRET_KEY=

# "development" or "production". Only "development" enables the debug
# reloader in run.py and permits the secret fallbacks below.
FLASK_ENV=development

# --- JWT -------------------------------------------------------------
# Signs access and refresh tokens. Generate the same way as SECRET_KEY and
# make it a DIFFERENT value. Required outside development; if it is missing
# the app raises at startup rather than signing tokens with a key that is
# visible in the source.
JWT_SECRET_KEY=

# --- Database --------------------------------------------------------
# This project runs on MySQL 8. requirements.txt ships PyMySQL and no
# PostgreSQL driver, so a postgresql:// URL will not work without adding
# psycopg2-binary and a matching prefix fix in app/__init__.py.
#
# MySQL (local):
DATABASE_URL=mysql+pymysql://atozflix_user:your_password@127.0.0.1:3306/atozflix_db
# MySQL (hosted):
# DATABASE_URL=mysql+pymysql://user:password@host:3306/dbname
# SQLite (quick local throwaway only - the data pipeline assumes MySQL):
# DATABASE_URL=sqlite:///movies.db

# Connection pool. Defaults shown; raise DB_POOL_SIZE only if the host
# allows more connections than workers x pool_size.
# DB_POOL_SIZE=10
# DB_POOL_RECYCLE=3600

# --- CORS ------------------------------------------------------------
# Comma-separated list of allowed browser origins, no trailing slashes.
# The deployed frontend origin MUST be listed here or every cross-origin
# request fails preflight - and the browser reports that as a generic
# network error, so it is an easy one to misdiagnose.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
# CORS_ORIGINS=https://your-site.netlify.app

# --- TMDb ------------------------------------------------------------
# Either scheme works. The v4 read token is preferred when both are set.
# Only the data-pipeline scripts and the lazy actor-detail fetch use these.
TMDB_API_KEY=your-tmdb-v3-api-key
# TMDB_ACCESS_TOKEN=your-tmdb-v4-read-access-token

# --- Data pipeline (build time only, not needed to serve requests) ----
# Directory holding the extracted MovieLens 25M dataset (ratings.csv,
# links.csv, movies.csv). Relative paths resolve against backend/, so
# ../ml-25m is the repository root. Download:
#   https://files.grouplens.org/datasets/movielens/ml-25m.zip
MOVIELENS_DIR=../ml-25m

# --- Runtime ---------------------------------------------------------
# Port to bind. Deploy hosts usually inject this themselves.
# PORT=5000
